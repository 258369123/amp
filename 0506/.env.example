# AMP Platform Configuration Example
# Copy this file to .env and customize for your environment

# General Settings
AMP_APP_NAME=AMP
AMP_DEBUG=false
AMP_LOG_LEVEL=INFO
AMP_DATA_DIR=./data

# Database Configuration
AMP_DATABASE__URL=sqlite:///amp.db
AMP_DATABASE__ECHO=false

# Tunnel Configuration
AMP_TUNNEL__MAX_TUNNELS=20
AMP_TUNNEL__HEARTBEAT_INTERVAL=30
AMP_TUNNEL__RECONNECT_ATTEMPTS=3
AMP_TUNNEL__RECONNECT_DELAY=5

# Tunnel Binary Paths (optional - configure one of these methods)
# Method 1: Set environment variables (recommended)
CHISEL_PATH=/path/to/chisel
LIGOLO_PATH=/path/to/ligolo-ng

# Method 2: Use AMP config (alternative)
# AMP_TUNNEL__CHISEL_BINARY=/path/to/chisel
# AMP_TUNNEL__LIGOLO_BINARY=/path/to/ligolo-ng

# Method 3: Install in system PATH
# sudo cp chisel /usr/local/bin/
# sudo cp ligolo-ng /usr/local/bin/

# Shell Configuration
AMP_SHELL__MAX_SHELLS=50
AMP_SHELL__DEFAULT_TIMEOUT=30
AMP_SHELL__ZOMBIE_CHECK_INTERVAL=60

# Context Engine Configuration
AMP_CONTEXT__MAX_TOKENS=80000
AMP_CONTEXT__COMPRESSION_THRESHOLD=0.7
AMP_CONTEXT__VECTOR_DB_PATH=./chroma_db
AMP_CONTEXT__EMBEDDING_MODEL=all-MiniLM-L6-v2

# MCP Server Configuration
AMP_MCP__HOST=127.0.0.1
AMP_MCP__PORT=8899
AMP_MCP__AUTH_TOKEN=your-secret-token-here
AMP_MCP__CORS_ORIGINS=["*"]

# Security Configuration
AMP_SECURITY__DOCKER_ISOLATION=false
AMP_SECURITY__NETWORK_ISOLATION=false
AMP_SECURITY__LOG_COMMANDS=true
AMP_SECURITY__LOG_OUTPUT=false
